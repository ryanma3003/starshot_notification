# ---- Discord (required) ----
# Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy
# Optional: ping yourself. <@123456789> for a user, <@&123456789> for a role.
DISCORD_MENTION=

# ---- noVNC (required when running in Docker) ----
# You sign in to your SSO provider through this. The container holds a live
# session, so the port is bound to loopback only - reach it over an SSH tunnel:
#   ssh -N -L 6080:localhost:6080 you@your-server
# Then open http://localhost:6080/vnc.html
VNC_PASSWORD=

# ---- Authentication ----
# The site is behind corporate SSO, whose session cookie is
# session-scoped: it dies when the browser closes and CANNOT be restored from
# disk. Every account needs 2FA from your phone, so sign-in is always manual:
# the watcher keeps one browser open per account and you sign in through noVNC
# whenever it starts or a session lapses.
#
# No credentials are stored anywhere. There is nothing to configure here.

# ---- Polling ----
# Required - the broker page to watch. There is no default.
STARSHOT_URL=
POLL_INTERVAL_SECONDS=300

# ---- Extraction: "dom" or "api". Fill in after running discover.py ----
EXTRACT_MODE=dom

# DOM mode: CSS selector matching ONE task row/card
TASK_SELECTOR=
# Optional attribute on that element holding a stable id (e.g. data-task-id)
TASK_ID_ATTR=
# Selector proving the app rendered while logged in. Guards against silently
# reporting "0 tasks" when the page simply failed to load.
APP_READY_SELECTOR=#root > *

# API mode: substring matched against network request URLs
TASK_API_PATTERN=
# Dotted path to the list inside the JSON body, e.g. data.tasks (blank = root)
TASK_API_LIST_PATH=
TASK_API_ID_FIELD=id
TASK_API_TITLE_FIELD=name

# ---- Behaviour ----
HEADLESS=true
NAV_TIMEOUT_MS=45000
STATE_DIR=./state
# Also notify when the queue goes empty -> non-empty, even for familiar ids.
NOTIFY_ON_REFILL=false

# How long to wait for a human to complete sign-in (seconds)
LOGIN_TIMEOUT_SECONDS=900

# ---- Multi-account ----
# Define accounts in accounts.json (see accounts.example.json).
# Without that file the watcher runs a single account using DISCORD_WEBHOOK_URL.
